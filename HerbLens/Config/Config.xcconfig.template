// HerbLens Configuration Template
// Copy this file to Debug.xcconfig and Release.xcconfig, then fill in your values.
// NEVER commit the actual .xcconfig files — they are gitignored.
//
// The Google/Gemini API key lives ONLY on the server (Supabase edge functions).
// The iOS app never calls Google directly — it calls Supabase edge functions,
// which hold GEMINI_API_KEY as a Supabase secret.

SUPABASE_URL = https://your-project.supabase.co
SUPABASE_ANON_KEY = your-anon-key-here
REVENUECAT_API_KEY = your-revenuecat-key-here
POSTHOG_API_KEY = your-posthog-key-here
POSTHOG_HOST = https://us.i.posthog.com
